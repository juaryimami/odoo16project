<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Category for Book Club -->
        <record model="ir.module.category" id="module_category_book_club">
            <field name="name">Book Club</field>
            <field name="description">Helps you manage your book club.</field>
            <field name="sequence">20</field>
        </record>

        <!-- User Group -->
        <record id="group_book_club_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_book_club"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager Group -->
        <record id="group_book_club_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_book_club"/>
            <field name="implied_ids" eval="[(4, ref('book_club.group_book_club_user'))]"/>
        </record>

        <!-- Administrator Group -->
        <record id="group_book_club_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_book_club"/>
            <field name="implied_ids" eval="[(4, ref('book_club.group_book_club_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <!-- User can only see their own borrow records -->
        <record id="rule_borrow_user" model="ir.rule">
            <field name="name">User can see own borrows</field>
            <field name="model_id" ref="model_book_club_borrow"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('book_club.group_book_club_user'))]"/>
        </record>

        <!-- Manager can see all borrow records -->
        <record id="rule_borrow_manager" model="ir.rule">
            <field name="name">Manager can see all borrows</field>
            <field name="model_id" ref="model_book_club_borrow"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('book_club.group_book_club_manager'))]"/>
        </record>
    </data>
</odoo>
