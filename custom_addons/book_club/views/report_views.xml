<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Overdue Books Report -->
    <record id="action_report_overdue_books" model="ir.actions.act_window">
        <field name="name">Overdue Books</field>
        <field name="res_model">book_club.borrow</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_overdue', '=', True)]</field>
        <field name="context">{'search_default_group_by_book': 1}</field>
    </record>

    <menuitem id="menu_report_overdue_books"
              name="Overdue Books"
              parent="menu_book_club_reports"
              action="action_report_overdue_books"
              sequence="10"/>

    <!-- 2. Most Borrowed Books Report -->
    <!-- We need a Pivot or Graph view on the Borrow model -->
    <record id="view_borrow_pivot" model="ir.ui.view">
        <field name="name">book.club.borrow.pivot</field>
        <field name="model">book_club.borrow</field>
        <field name="arch" type="xml">
            <pivot string="Most Borrowed Books">
                <field name="book_id" type="row"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_borrow_graph" model="ir.ui.view">
        <field name="name">book.club.borrow.graph</field>
        <field name="model">book_club.borrow</field>
        <field name="arch" type="xml">
            <graph string="Most Borrowed Books">
                <field name="book_id"/>
            </graph>
        </field>
    </record>

    <record id="action_report_most_borrowed" model="ir.actions.act_window">
        <field name="name">Most Borrowed Books</field>
        <field name="res_model">book_club.borrow</field>
        <field name="view_mode">pivot,graph,tree</field>
    </record>

    <menuitem id="menu_report_most_borrowed"
              name="Most Borrowed Books"
              parent="menu_book_club_reports"
              action="action_report_most_borrowed"
              sequence="20"/>

    <!-- 3. Member Activity Report - Group by Member -->
    <record id="action_report_member_activity" model="ir.actions.act_window">
        <field name="name">Member Activity</field>
        <field name="res_model">book_club.borrow</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_member': 1}</field>
    </record>

    <menuitem id="menu_report_member_activity"
              name="Member Activity"
              parent="menu_book_club_reports"
              action="action_report_member_activity"
              sequence="30"/>
</odoo>
