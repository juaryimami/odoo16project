<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_construction" model="ir.ui.view">
        <field name="name">account.move.form.inherit.construction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_owner_approve" string="Owner Approve &amp; Post" type="object" class="btn-success" attrs="{'invisible': ['|', '|', ('move_type', '!=', 'in_invoice'), ('project_owner_id', '=', False), ('is_owner_approved', '=', True)]}"/>
                <field name="is_owner_approved" invisible="1"/>
                <field name="project_owner_id" invisible="1"/>
            </xpath>
            <xpath expr="//header/button[@name='action_post']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', '!=', 'draft'), '&amp;', ('project_owner_id', '!=', False), ('is_owner_approved', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="project_id" options="{'no_create': True}" attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt'))]}"/>
                <field name="job_order_id" string="Work Order" options="{'no_create': True}" attrs="{'invisible': [('project_id', '=', False)]}"/>
                <field name="phase_id" options="{'no_create': True}" attrs="{'invisible': [('project_id', '=', False)]}"/>
                <field name="lifecycle_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="after">
                <field name="lifecycle_id" invisible="1"/>
                <field name="construction_phase_id" optional="show"/>
                <field name="cost_line_id" optional="show" domain="[('cost_sheet_id.project_id', '=', parent.project_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>
