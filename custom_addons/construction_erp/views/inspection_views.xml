<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_inspection_tree" model="ir.ui.view">
        <field name="name">construction.inspection.tree</field>
        <field name="model">construction.inspection</field>
        <field name="arch" type="xml">
            <tree string="Quality Inspections">
                <field name="name"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="inspector_id"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_construction_inspection_form" model="ir.ui.view">
        <field name="name">construction.inspection.form</field>
        <field name="model">construction.inspection</field>
        <field name="arch" type="xml">
            <form string="Quality Inspection">
                <header>
                    <button name="action_generate_ncr" string="Generate NCR" type="object" states="failed" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,passed,failed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_ncrs" type="object" icon="fa-exclamation-triangle" attrs="{'invisible': [('ncr_count', '=', 0)]}">
                            <field name="ncr_count" widget="statinfo" string="NCRs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="job_context">
                            <field name="job_order_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="phase_id" readonly="1"/>
                            <field name="task_id" readonly="1"/>
                            <field name="milestone_id" invisible="1"/>
                        </group>
                        <group name="inspector_info">
                            <field name="inspection_type" attrs="{'readonly': [('is_submitted', '=', True)]}"/>
                            <field name="inspector_id" options="{'no_create': True}" attrs="{'readonly': [('is_submitted', '=', True)]}"/>
                            <field name="date" attrs="{'readonly': [('is_submitted', '=', True)]}"/>
                            <field name="is_requested" invisible="1"/>
                            <field name="is_submitted" readonly="1"/>
                        </group>
                    </group>
                    <group string="Payment Verification Context" attrs="{'invisible': [('inspection_type', '!=', 'evaluation')]}">
                        <group>
                            <field name="cpr_id"/>
                            <field name="previous_certified_progress"/>
                        </group>
                        <group>
                            <field name="current_progress_claim"/>
                            <field name="total_claim_progress" class="oe_read_only fw-bold text-success"/>
                        </group>
                    </group>
                    <group string="Security &amp; Portal Access">
                        <field name="portal_url" widget="url" readonly="1"/>
                        <field name="access_token" readonly="1" groups="base.group_no_one"/>
                    </group>
                    <notebook>
                        <page string="QA Checklist Items" name="lines">
                            <field name="line_ids" attrs="{'readonly': [('is_submitted', '=', True)]}">
                                <tree editable="bottom">
                                    <field name="checklist_line_id" invisible="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="status" decoration-success="status == 'pass'" decoration-danger="status == 'fail'"/>
                                    <field name="notes" placeholder="Rework instructions..."/>
                                </tree>
                            </field>
                        </page>
                        <page string="Contractor Feedback" name="contractor_feedback">
                            <group>
                                <field name="contractor_remarks" attrs="{'readonly': [('is_requested', '=', True)]}"/>
                            </group>
                        </page>
                        <page string="Overall Audit Remarks" name="remarks">
                            <field name="notes" placeholder="Detailed overall summary..." attrs="{'readonly': [('state', 'in', ['passed', 'failed'])]}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_construction_inspection" model="ir.actions.act_window">
        <field name="name">Quality Inspections</field>
        <field name="res_model">construction.inspection</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_construction_inspections"
              name="Inspections"
              parent="menu_construction_operations"
              action="action_construction_inspection"
              sequence="30"/>
</odoo>
