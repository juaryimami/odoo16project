<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_checklist_import_wizard_form" model="ir.ui.view">
        <field name="name">construction.checklist.import.wizard.form</field>
        <field name="model">construction.checklist.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Checklist Items">
                <sheet>
                    <div class="row align-items-center mb-4 mt-2">
                        <div class="col-auto">
                            <span class="fa fa-file-excel-o fa-3x text-primary"/>
                        </div>
                        <div class="col">
                            <h2 class="mb-0">Bulk Import Checklist Items</h2>
                            <p class="text-muted mb-0">Upload a spreadsheet to quickly populate your checklist template lines.</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-8">
                            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                                <span class="fa fa-info-circle fa-2x mr-3"/>
                                <div>
                                    <strong>Template Guide:</strong> Please ensure your file has columns for 
                                    <b>Sequence</b>, <b>Item Name</b>, and <b>Mandatory</b>.
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="File Configuration">
                            <field name="template_id" invisible="1"/>
                            <field name="file" filename="file_name" widget="binary" string="Upload Spreadsheet"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group string="Get Started">
                            <span class="o_form_label">Sample Template</span>
                            <div>
                                <a href="/construction/checklist_template" class="btn btn-outline-primary" target="_blank">
                                    <i class="fa fa-download me-1"/> Download Excel Template
                                </a>
                            </div>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert" style="border-left: 5px solid #ffc107;">
                        <i class="fa fa-lightbulb-o mr-2"/>
                        <b>Pro Tip:</b> Use <i>"Yes"</i> or <i>"No"</i> in the <b>Mandatory</b> column to configure gate compliance.
                    </div>
                </sheet>
                <footer>
                    <button name="action_import" string="Start Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_construction_checklist_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Checklist Items</field>
        <field name="res_model">construction.checklist.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
