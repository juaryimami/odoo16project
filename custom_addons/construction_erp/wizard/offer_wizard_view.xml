<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_job_offer_wizard_form" model="ir.ui.view">
        <field name="name">construction.job.offer.wizard.form</field>
        <field name="model">construction.job.offer.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Job Offer to Contractor">
                <group>
                    <group>
                        <field name="job_order_id" readonly="1" options="{'no_open': True}"/>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="email_template_id" invisible="1"/>
                        <field name="contract_type" readonly="1" options="{'no_open': True}"/>
                        <field name="advance_payment_pct" string="Advance Payment %"/>
                        <field name="subject"/>
                    </group>
                </group>
                <separator string="Email Notification Details"/>
                <field name="body" widget="html" options="{'style-inline': true}"/>
                
                <group string="Formal Authorization (for PDF Contract)">
                    <field name="pm_name" placeholder="Full Name as it should appear on contract"/>
                    <field name="pm_signature" widget="signature" string="Project Manager Signature"/>
                </group>
                
                <separator string="Additional Attachments"/>
                <p class="text-muted">A PDF copy of the Job Order Contract (filtering for Labor &amp; Fleet) will be automatically attached.</p>
                <field name="attachment_ids" widget="many2many_binary"/>
                
                <footer>
                    <button name="action_send_offer" string="Send Offer" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
