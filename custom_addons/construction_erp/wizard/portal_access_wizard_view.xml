<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_portal_access_wizard" model="ir.ui.view">
        <field name="name">construction.portal.access.wizard.form</field>
        <field name="model">construction.portal.access.wizard</field>
        <field name="arch" type="xml">
            <form string="Grant Customer Portal Access">
                <div class="alert alert-success text-center mb-4" role="alert" style="background-color: #d4edda; color: #155724; border-color: #c3e6cb; padding: 15px; border-radius: 5px;">
                    <i class="fa fa-shield fa-2x mb-2" style="display: block;"></i>
                    <strong>Secure Portal Generation</strong><br/>
                    Review the auto-generated credentials below. Once confirmed, an email will be sent automatically.
                </div>
                
                <group col="2">
                    <group string="Client Information">
                        <field name="sale_id" invisible="1"/>
                        <field name="partner_id" readonly="1" options="{'no_open': True}"/>
                        <field name="email" widget="email"/>
                    </group>
                    <group string="Generated Credentials">
                        <field name="username"/>
                        <field name="password"/>
                        <field name="portal_link" readonly="1" widget="url"/>
                    </group>
                </group>
                
                <footer>
                    <button name="action_grant_access" type="object" string="Confirm &amp; Send Email" class="btn-primary" icon="fa-envelope"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
