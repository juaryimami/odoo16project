<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_orbit_hr_leave" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.orbit.hr.leave</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='employee_rights_setting_container']" position="after">
                <h2>Probation Settings</h2>
                <div class="row mt16 o_settings_container" id="orbit_probation_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="probation_working_days_setting">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="probation_working_days"/>
                            <div class="text-muted">
                                Set the default number of working days for employee probation periods.
                            </div>
                            <div class="content-group mt16">
                                <field name="probation_working_days"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
