<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_by_employees_orbit_inherit" model="ir.ui.view">
        <field name="name">hr_payroll_payslip_employees_orbit_inherit</field>
        <field name="model">hr.payslip.employees</field>
        <field name="inherit_id" ref="hr_payroll_community.view_hr_payslip_by_employees"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_ids']" position="before">
                <group>
                    <field name="structure_id" options="{'no_create': True}" placeholder="Override Structure (Optional)"/>
                </group>
                <p class="text-muted">
                    If you select a Structure above, it will override the employees' default contract structure for this batch. 
                    Payslip errors are logged gracefully to the batch chatter.
                </p>
            </xpath>
        </field>
    </record>
</odoo>
