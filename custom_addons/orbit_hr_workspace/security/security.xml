<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_hr_employee_workspace">
            <field name="name">Employee Workspace</field>
            <field name="description">Helps you manage your self service features.</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_hr_employee_workspace" model="res.groups">
            <field name="name">Employee Workspace User</field>
            <field name="category_id" ref="module_category_hr_employee_workspace"/>
        </record>

        <record id="group_hr_workspace_allow_manul_attendance" model="res.groups">
            <field name="name">Allow to mark manual attendance</field>
            <field name="category_id" ref="module_category_hr_employee_workspace"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_employee_workspace'))]"/>
        </record>

        <record id="hr_employee_workspace_self_edit_rule" model="ir.rule">
            <field name="name">Employee Workspace: Edit Own Profile</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
