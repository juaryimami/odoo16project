<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="orbit_hr_workspace.ListView.Buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <button type="button" class="btn btn-secondary ms-2" t-on-click="onGenerateAttendances">
                Generate Attendances
            </button>
            <button type="button" class="btn btn-primary ms-2" t-on-click="onBulkApproveAttendances">
                Bulk Approve
            </button>
            <button type="button" class="btn btn-danger ms-2" t-on-click="onBulkAbsentAttendances">
                Bulk Absent
            </button>
        </xpath>
    </t>
</templates>
