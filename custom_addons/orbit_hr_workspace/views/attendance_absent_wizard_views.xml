<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_absent_wizard_form" model="ir.ui.view">
        <field name="name">orbit.attendance.absent.wizard.form</field>
        <field name="model">orbit.attendance.absent.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Absent Attendances">
                <div class="alert alert-info text-center" role="alert">
                    <strong>Bulk Attendance Marker</strong><br/>
                    Select the employees and add specific dates. The system will automatically construct the exact working hours from their schedule and mark them as absent.
                </div>
                <group>
                    <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <notebook>
                    <page string="Absent Dates">
                        <field name="date_lines">
                            <tree editable="bottom">
                                <field name="date"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_mark_absent" string="MARK AS ABSENT" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_absent_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Absent</field>
        <field name="res_model">orbit.attendance.absent.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
