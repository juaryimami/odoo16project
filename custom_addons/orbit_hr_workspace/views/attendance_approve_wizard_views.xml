<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_approve_wizard_form" model="ir.ui.view">
        <field name="name">orbit.attendance.approve.wizard.form</field>
        <field name="model">orbit.attendance.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Approve Attendances">
                <sheet>
                    <div class="alert alert-info text-center" role="alert">
                        <strong>Bulk Attendance Approver</strong><br/>
                        Select a date range and the employees whose unapproved attendances you wish to approve.
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Approve Attendances" name="action_approve_attendances" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_approve_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Approve Attendances</field>
        <field name="res_model">orbit.attendance.approve.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
