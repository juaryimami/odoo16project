<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_generator_tree" model="ir.ui.view">
        <field name="name">hr.attendance.generator.tree</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="js_class">attendance_generator_list</attribute>
            </xpath>
            <xpath expr="//tree" position="inside">
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'absent'" decoration-info="state == 'draft'"/>
                <button name="action_approve_attendance" string="Approve" type="object" icon="fa-check" 
                        attrs="{'invisible': [('state', '=', 'approved')]}" 
                        groups="hr_attendance.group_hr_attendance_manager"/>
                <button name="action_mark_absent" string="Mark Absent" type="object" icon="fa-times" 
                        attrs="{'invisible': [('state', '=', 'absent')]}" 
                        groups="hr_attendance.group_hr_attendance_manager" class="text-danger"/>
            </xpath>
        </field>
    </record>

    <record id="view_attendance_form_approve" model="ir.ui.view">
        <field name="name">hr.attendance.form.approve</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_approve_attendance" string="Approve" type="object" class="btn-primary" 
                            attrs="{'invisible': [('state', '=', 'approved')]}" 
                            groups="hr_attendance.group_hr_attendance_manager"/>
                    <button name="action_mark_absent" string="Mark Absent" type="object" class="btn-danger" 
                            attrs="{'invisible': [('state', '=', 'absent')]}" 
                            groups="hr_attendance.group_hr_attendance_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,absent"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="action_my_attendance" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_attendance_generator_tree"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No attendance records to display
            </p><p>
                The attendance records of your employees will be displayed here.
            </p>
        </field>
    </record>

    <record id="action_my_attendance_kiosk_mode" model="ir.actions.client">
        <field name="name">Attendances</field>
        <field name="tag">hr_attendance_kiosk_mode</field>
        <field name="target">fullscreen</field>
    </record>

    <record id="action_my_attendance_checkin_checkout" model="ir.actions.client">
        <field name="name">Attendance</field>
        <field name="tag">hr_attendance_my_attendances</field>
        <field name="target">main</field>
    </record>
    
    <menuitem id="menu_my_attendance" name="My Attendance" parent="menu_my_workspace" sequence="20"/>
    <menuitem id="menu_my_attendance_attendance" name="Attendance" parent="menu_my_attendance" action="action_my_attendance" sequence="10"/>
    <menuitem id="menu_my_attendance_checkin_checkout" name="Check In/Check Out" parent="menu_my_attendance" action="action_my_attendance_checkin_checkout" sequence="20" groups="orbit_hr_workspace.group_hr_workspace_allow_manul_attendance"/>
</odoo>
