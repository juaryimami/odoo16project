<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="early_retirement_request_email_template_id" model="mail.template">
           <field name="name">Early Retirement Request</field>
           <field name="model_id" ref="early_retirement.model_early_retirement"/>
           <field name="email_from">{{object.employee_id.work_email}}</field>
           <field name="email_to">{{object.employee_id.parent_id.work_email}}</field>
           <field name="subject">Early Retirement Request</field>
           <field name="body_html" type="html">
               <p> <span>Dear <t t-esc="object.employee_id.parent_id.name"/> </span></p>
               <p>I would like to formally request early retirement from my position at <t t-esc="object.employee_id.company_id.name"/>,
                   effective <t t-esc="object.requested_date"/>. After careful consideration, I believe this is the best decision for my personal
                    circumstances.
                    </p>
               <p>Thank you for your understanding and assistance.</p>
               <p>Best regards</p>
           </field>
       </record>

        <record id="early_retirement_approval_email_template_id" model="mail.template">
           <field name="name">Early Retirement Request</field>
           <field name="model_id" ref="early_retirement.model_early_retirement"/>
           <field name="email_from">{{object.employee_id.parent_id.work_email}}</field>
           <field name="email_to">{{object.employee_id.work_email}}</field>
           <field name="subject">Early Retirement Request Approval </field>
           <field name="body_html" type="html">
               <p> <span>Dear <t t-esc="object.employee_id.name"/> </span></p>
               <p>I am pleased to inform you that your request for early retirement has been approved. Your last working
                    day will be <t t-esc="object.requested_date"/>, as requested. </p>

                   <p>Please note that you are expected to complete the clearance process in order to receive your last salary
                        payment. We appreciate your contributions to  <t t-esc="object.employee_id.company_id.name"/> and wish you all the best in your future
                        endeavors. </p>
                   <p>Thank you for your dedicated service.</p>
                   <p>Best regards, </p>

           </field>
       </record>

    <record id="early_retirement_rejected_email_template_id" model="mail.template">
           <field name="model_id" ref="early_retirement.model_early_retirement"/>
           <field name="email_from">{{object.employee_id.parent_id.work_email}}</field>
           <field name="email_to">{{object.employee_id.work_email}}</field>
           <field name="subject">Early Retirement Request Rejection</field>
           <field name="body_html" type="html">
               <p> <span>Dear <t t-esc="object.employee_id.name"/> </span></p>
               <p>After careful consideration, I regret to inform you that we are unable to approve your request at this
                    time due to <t t-esc="object.rejection_reason"/> </p>
               <p>If you would like to discuss this further or explore other options, please feel free to reach out.</p>
               <p>Thank you for your understanding.</p>
               <p>Best regards, </p>

           </field>
       </record>
    </data>
</odoo>