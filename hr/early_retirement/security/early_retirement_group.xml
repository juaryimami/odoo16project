        </record>
        <record id="early_retirement_group_approve" model="res.groups">
            <field name="name">Approve</field>
            <field name="category_id" ref="early_retirement_res_groups_category"/>
        </record>
        <record id="early_retirement_group_expired" model="res.groups">
            <field name="name">Reject</field>
            <field name="category_id" ref="early_retirement_res_groups_category"/>
        </record>
