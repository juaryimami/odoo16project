        <record model="ir.module.category" id="early_retirement_res_groups_category">
            <field name="name">Early Retirement</field>
            <field name="description">Helps you manage your employee early retirement.</field>
        </record>

        <record id="early_retirement_group_submit" model="res.groups">
            <field name="name">Submit</field>
            <field name="category_id" ref="early_retirement_res_groups_category"/>
        </record>
