    <record id="view_employee_resume_line_attachment" model="ir.ui.view">
        <field name="name">hr.resume.line.attachemnt</field>
        <field name="model">hr.resume.line</field>
        <field name="inherit_id" ref="hr_skills.resume_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="after">
                <group string="Resume">
                    <field name="resume_attachment" filename="resume_filename" widget="binary"/>
                    <field name="resume_filename" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_hr_language_tree" model="ir.ui.view">
        <field name="name">hr.language.tree</field>
        <field name="model">hr.language</field>
        <field name="arch" type="xml">
            <tree string="Languages">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Form View for hr.language -->
    <record id="view_hr_institution_form" model="ir.ui.view">
        <field name="name">hr.institution.form</field>
        <field name="model">hr.institutions</field>
        <field name="arch" type="xml">
            <form string="Institution">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hr_institutions" model="ir.actions.act_window">
        <field name="name">Institutions</field>
        <field name="res_model">hr.institutions</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu item for hr.language under HR Configuration -->
    <menuitem id="menu_hr_institution" name="Institutions" action="action_hr_institutions" parent="hr.menu_human_resources_configuration" sequence="11"/>


