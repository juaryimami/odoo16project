<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_construction">
            <field name="name">Construction ERP</field>
            <field name="description">Construction and Real Estate Management</field>
            <field name="sequence">15</field>
        </record>

        <record id="group_construction_supervisor" model="res.groups">
            <field name="name">Site Supervisor</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_construction_manager" model="res.groups">
            <field name="name">Construction Manager</field>
            <field name="category_id" ref="module_category_construction"/>
            <!-- Add project mapping inherit natively -->
            <field name="implied_ids" eval="[(4, ref('construction_erp.group_construction_supervisor')), (4, ref('project.group_project_manager'))]"/>
        </record>
        <record id="group_construction_sales" model="res.groups">
            <field name="name">Sales Team</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- RECORD RULES: Isolation for Managers -->
        <record id="rule_project_manager_assigned_only" model="ir.rule">
            <field name="name">Construction: Managers see assigned projects only</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="groups" eval="[(4, ref('construction_erp.group_construction_supervisor')), (4, ref('construction_erp.group_construction_manager'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('site_manager_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_job_order_assigned_only" model="ir.rule">
            <field name="name">Construction: Managers see job orders of assigned projects only</field>
