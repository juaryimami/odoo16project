<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_erp.CustomerPortalLogin" owl="1">
        <div class="d-flex justify-content-center align-items-center flex-grow-1" style="min-height: 100vh; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
            <div class="card shadow-lg border-0" style="width: 450px; border-radius: 15px;">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <div class="bg-primary text-white rounded-circle d-inline-flex justify-content-center align-items-center mb-3 shadow" style="width: 80px; height: 80px;">
                            <i class="fa fa-building-o fa-3x"></i>
                        </div>
                        <h3 class="font-weight-bold text-dark">Client Portal</h3>
                        <p class="text-muted">Sign in to manage your properties</p>
                    </div>
                    
                    <t t-if="state.error">
                        <div class="alert alert-danger py-2 text-center rounded">
                            <i class="fa fa-exclamation-circle me-1"></i> <t t-esc="state.error"/>
                        </div>
                    </t>
                    
                    <form t-on-submit.prevent="submitLogin">
                        <div class="mb-4">
                            <label class="form-label font-weight-bold text-secondary">Email / Username</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa fa-envelope text-muted"></i></span>
                                <input type="text" class="form-control form-control-lg border-start-0 ps-0" t-model="state.username" required="1" placeholder="e.g. customer@example.com"/>
                            </div>
                        </div>
                        <div class="mb-5">
                            <label class="form-label font-weight-bold text-secondary">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="fa fa-lock text-muted"></i></span>
                                <input type="password" class="form-control form-control-lg border-start-0 ps-0" t-model="state.password" required="1" placeholder="Enter password"/>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 font-weight-bold shadow rounded-pill" t-att-disabled="state.loading">
                            <t t-if="state.loading">
                                <i class="fa fa-spinner fa-spin me-2"></i> Authenticating...
                            </t>
                            <t t-else="">
                                <i class="fa fa-sign-in me-2"></i> Secure Sign In
                            </t>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </t>
</templates>
