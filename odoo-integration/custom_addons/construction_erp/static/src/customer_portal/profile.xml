<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_erp.CustomerPortalProfile" owl="1">
        <div>
            <div class="mb-4">
                <button class="btn btn-outline-secondary btn-sm rounded-pill font-weight-bold shadow-sm" t-on-click="() => this.props.navigateTo('dashboard')">
                    <i class="fa fa-arrow-left me-2"></i> Back to Dashboard
                </button>
            </div>
            
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded">
                        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 text-center">
                            <div class="position-relative d-inline-block mb-3">
                                <t t-if="props.partnerId">
                                    <img t-attf-src="/web/image?model=res.partner&amp;id=#{props.partnerId}&amp;field=avatar_128&amp;unique=#{state.avatarTimestamp}" alt="Profile" class="rounded-circle shadow-sm bg-white" style="width: 100px; height: 100px; object-fit: cover; border: 3px solid #f8f9fa;"/>
                                </t>
                                <t t-else="">
                                    <div class="d-inline-flex justify-content-center align-items-center bg-primary text-white rounded-circle shadow-sm" style="width: 100px; height: 100px; font-size: 3rem;">
                                        <i class="fa fa-user"></i>
                                    </div>
                                </t>
                                <t t-if="state.uploadingAvatar">
                                    <div class="position-absolute top-50 start-50 translate-middle bg-white bg-opacity-75 rounded-circle w-100 h-100 d-flex justify-content-center align-items-center">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Uploading...</span>
                                        </div>
                                    </div>
                                </t>
                                <div class="dropdown position-absolute bottom-0 end-0" style="right: 0;">
                                    <button class="btn btn-primary text-white rounded-circle shadow-sm d-flex justify-content-center align-items-center" type="button" id="avatarUploadDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="width: 35px; height: 35px; border: 2px solid #fff; padding: 0;">
                                        <i class="fa fa-camera" style="font-size: 0.9rem;"></i>
                                    </button>
                                    <ul class="dropdown-menu shadow border-0 mt-1" aria-labelledby="avatarUploadDropdown">
                                        <li>
                                            <label class="dropdown-item py-2" style="cursor: pointer;">
                                                <i class="fa fa-image me-2 text-primary"></i> Choose from Gallery
                                                <input type="file" class="d-none" accept="image/*" t-on-change="onAvatarChange" t-att-disabled="state.uploadingAvatar"/>
                                            </label>
                                        </li>
                                        <li>
                                            <label class="dropdown-item py-2" style="cursor: pointer;">
                                                <i class="fa fa-camera-retro me-2 text-primary"></i> Take Photo
                                                <input type="file" class="d-none" accept="image/*" capture="user" t-on-change="onAvatarChange" t-att-disabled="state.uploadingAvatar"/>
                                            </label>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <h4 class="card-title font-weight-bold text-dark mb-0">Profile Settings</h4>
                        </div>
                        <div class="card-body p-4">
                            <t t-if="state.success">
                                <div class="alert alert-success d-flex align-items-center rounded border-0">
                                    <i class="fa fa-check-circle fa-2x me-3"></i>
                                    <div>
                                        <strong>Success!</strong><br/>
                                        Your password has been changed successfully.
                                    </div>
                                </div>
                            </t>
                            <t t-if="state.error">
                                <div class="alert alert-danger rounded border-0">
                                    <i class="fa fa-exclamation-circle me-1"></i> <t t-esc="state.error"/>
                                </div>
                            </t>
                            
                            <form t-on-submit.prevent="submitPasswordChange" t-if="!state.success">
                                <div class="mb-3">
                                    <label class="form-label font-weight-bold text-secondary">Current Password</label>
                                    <input type="password" class="form-control form-control-lg bg-light border-0 shadow-sm" t-model="state.oldPassword" placeholder="Enter your current password" required="1"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label font-weight-bold text-secondary">New Password</label>
                                    <div class="input-group shadow-sm">
                                        <input t-att-type="state.showNewPassword ? 'text' : 'password'" class="form-control form-control-lg bg-light border-0" t-model="state.newPassword" placeholder="Create a new password" required="1"/>
                                        <button class="btn btn-light border-0 bg-light text-muted px-3" type="button" t-on-click="toggleNewPassword">
                                            <i t-attf-class="fa #{state.showNewPassword ? 'fa-eye-slash' : 'fa-eye'}"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label font-weight-bold text-secondary">Confirm New Password</label>
                                    <div class="input-group shadow-sm">
                                        <input t-att-type="state.showConfirmPassword ? 'text' : 'password'" class="form-control form-control-lg bg-light border-0" t-model="state.confirmPassword" placeholder="Type your new password again" required="1"/>
                                        <button class="btn btn-light border-0 bg-light text-muted px-3" type="button" t-on-click="toggleConfirmPassword">
                                            <i t-attf-class="fa #{state.showConfirmPassword ? 'fa-eye-slash' : 'fa-eye'}"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill font-weight-bold shadow mt-2" t-att-disabled="state.loading">
                                    <t t-if="state.loading">
                                        <i class="fa fa-spinner fa-spin me-2"></i> Updating...
                                    </t>
                                    <t t-else="">
                                        <i class="fa fa-save me-2"></i> Update Password
                                    </t>
                                </button>
                            </form>
                            
                            <t t-if="state.success">
                                <button class="btn btn-outline-primary btn-lg w-100 rounded-pill font-weight-bold shadow-sm mt-3" t-on-click="() => this.props.navigateTo('dashboard')">
                                    Return to Dashboard
                                </button>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
