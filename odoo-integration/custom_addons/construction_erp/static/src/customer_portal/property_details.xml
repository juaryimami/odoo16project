<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_erp.CustomerPortalPropertyDetails" owl="1">
        <div>
            <div class="mb-4">
                <button class="btn btn-outline-secondary btn-sm rounded-pill font-weight-bold shadow-sm" t-on-click="() => this.props.navigateTo('dashboard')">
                    <i class="fa fa-arrow-left me-2"></i> Back to Dashboard
                </button>
            </div>
            
            <t t-if="state.loading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </t>
            <t t-elif="state.property">
                <!-- Header Banner -->
                <div class="bg-primary text-white p-4 rounded shadow-sm mb-4">
                    <h2 class="mb-1 font-weight-bold"><t t-esc="state.property.name"/></h2>
                    <p class="mb-1 lead"><i class="fa fa-building-o me-2"></i> <t t-esc="state.property.project_name"/></p>
                    <t t-if="state.property.unit_name">
                        <p class="mb-0 fs-5"><i class="fa fa-home me-2"></i> <t t-esc="state.property.unit_name"/></p>
                    </t>
                </div>
                
                <!-- Financial Cards -->
                <div class="row mb-4">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="card shadow-sm border-0 h-100 rounded">
                            <div class="card-body text-center py-4">
                                <h6 class="text-uppercase text-muted font-weight-bold mb-2">Total Purchase Value</h6>
                                <h3 class="text-primary mb-0"><t t-esc="state.property.currency"/> <t t-esc="state.property.total_amount.toLocaleString()"/></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="card shadow-sm border-0 h-100 rounded">
                            <div class="card-body text-center py-4">
                                <h6 class="text-uppercase text-muted font-weight-bold mb-2">Total Paid</h6>
                                <h3 class="text-success mb-0"><t t-esc="state.property.currency"/> <t t-esc="state.property.total_paid.toLocaleString()"/></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100 rounded bg-light">
                            <div class="card-body text-center py-4">
                                <h6 class="text-uppercase text-muted font-weight-bold mb-2">Remaining Balance</h6>
                                <h3 class="text-danger mb-0"><t t-esc="state.property.currency"/> <t t-esc="state.property.remaining_balance.toLocaleString()"/></h3>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Progress Bar -->
                <div class="card shadow-sm border-0 rounded mb-4">
                    <div class="card-body p-4">
                        <h6 class="mb-3 font-weight-bold text-muted text-uppercase text-center">Payment Progress</h6>
                        <div class="progress rounded-pill bg-light border shadow-inner" style="height: 30px;">
                            <div class="progress-bar bg-success rounded-pill font-weight-bold" role="progressbar" t-attf-style="width: #{state.property.progress_pct}%; font-size: 14px; box-shadow: inset 0 1px 2px rgba(255,255,255,0.3);">
                                <t t-esc="state.property.progress_pct"/>% Paid
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Tabs -->
                <ul class="nav nav-pills nav-fill bg-white shadow-sm rounded p-2 mb-4">
                    <li class="nav-item">
                        <a t-attf-class="nav-link rounded font-weight-bold #{state.activeTab === 'installments' ? 'active shadow-sm' : 'text-muted'}" href="#" t-on-click.prevent="() => this.setTab('installments')">
                            <i class="fa fa-calendar-check-o me-2"></i> Installments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a t-attf-class="nav-link rounded font-weight-bold #{state.activeTab === 'invoices' ? 'active shadow-sm' : 'text-muted'}" href="#" t-on-click.prevent="() => this.setTab('invoices')">
                            <i class="fa fa-money me-2"></i> Invoices
                        </a>
                    </li>
                    <li class="nav-item">
                        <a t-attf-class="nav-link rounded font-weight-bold #{state.activeTab === 'documents' ? 'active shadow-sm' : 'text-muted'}" href="#" t-on-click.prevent="() => this.setTab('documents')">
                            <i class="fa fa-file-text-o me-2"></i> Documents
                        </a>
                    </li>
                    <li class="nav-item">
                        <a t-attf-class="nav-link rounded font-weight-bold #{state.activeTab === 'map' ? 'active shadow-sm' : 'text-muted'}" href="#" t-on-click.prevent="() => this.setTab('map')">
                            <i class="fa fa-map-marker me-2"></i> Map View
                        </a>
                    </li>
                </ul>
                
                <!-- Tab Content -->
                <div class="bg-white p-4 shadow-sm rounded mb-5">
                    <!-- Installments Tab -->
                    <t t-if="state.activeTab === 'installments'">
                        <t t-if="state.loadingInstallments">
                            <div class="text-center py-4"><i class="fa fa-spinner fa-spin text-primary fa-2x"></i></div>
                        </t>
                        <t t-elif="state.installments.length === 0">
                            <div class="alert alert-warning text-center">No installments found.</div>
                        </t>
                        <t t-else="">
                            <div class="table-responsive">
                                <table class="table table-hover table-borderless table-striped align-middle">
                                    <thead class="bg-light text-muted">
                                        <tr>
                                            <th>Description</th>
                                            <th>Due Date</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.installments" t-as="line" t-key="line.id">
                                            <tr>
                                                <td class="font-weight-bold text-dark"><t t-esc="line.name"/></td>
                                                <td><t t-esc="line.due_date"/></td>
                                                <td class="text-end font-weight-bold"><t t-esc="line.currency"/> <t t-esc="line.amount.toLocaleString()"/></td>
                                                <td class="text-center">
                                                    <span t-if="line.status === 'Paid'" class="badge bg-success rounded-pill px-3 py-2">Paid</span>
                                                    <span t-elif="line.status === 'In Payment'" class="badge bg-info rounded-pill px-3 py-2">In Payment</span>
                                                    <span t-elif="line.status === 'Invoiced'" class="badge bg-warning text-dark rounded-pill px-3 py-2">Invoiced</span>
                                                    <span t-else="" class="badge bg-secondary rounded-pill px-3 py-2">Upcoming</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Pagination -->
                            <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" t-att-disabled="state.installmentsOffset === 0" t-on-click="prevInstallments">
                                    <i class="fa fa-chevron-left me-1"></i> Previous
                                </button>
                                <span class="text-muted small">
                                    Showing <t t-esc="state.installmentsOffset + 1"/> to <t t-esc="Math.min(state.installmentsOffset + state.installmentsLimit, state.installmentsTotal)"/> of <t t-esc="state.installmentsTotal"/>
                                </span>
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" t-att-disabled="state.installmentsOffset + state.installmentsLimit >= state.installmentsTotal" t-on-click="nextInstallments">
                                    Next <i class="fa fa-chevron-right ms-1"></i>
                                </button>
                            </div>
                        </t>
                    </t>
                    
                    <!-- Invoices Tab -->
                    <t t-if="state.activeTab === 'invoices'">
                        <t t-if="state.loadingInvoices">
                            <div class="text-center py-4"><i class="fa fa-spinner fa-spin text-primary fa-2x"></i></div>
                        </t>
                        <t t-elif="state.invoices.length === 0">
                            <div class="alert alert-info text-center">No invoices found.</div>
                        </t>
                        <t t-else="">
                            <div class="row">
                                <t t-foreach="state.invoices" t-as="inv" t-key="inv.id">
                                    <div class="col-md-6 mb-3">
                                        <div class="card border shadow-sm h-100 transition-hover">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <h5 class="card-title mb-0 text-primary font-weight-bold"><t t-esc="inv.name"/></h5>
                                                    <span t-if="inv.status === 'Paid'" class="badge bg-success rounded-pill"><i class="fa fa-check-circle me-1"></i> Paid</span>
                                                    <span t-else="" class="badge bg-warning text-dark rounded-pill"><i class="fa fa-clock-o me-1"></i> Pending</span>
                                                </div>
                                                <p class="card-text text-muted mb-2"><i class="fa fa-calendar me-2"></i> Date: <t t-esc="inv.invoice_date"/></p>
                                                <p class="card-text font-weight-bold mb-3">Total: <t t-esc="inv.currency"/> <t t-esc="inv.amount_total.toLocaleString()"/></p>
                                                <a t-att-href="inv.url" class="btn btn-outline-primary btn-sm w-100 rounded-pill font-weight-bold">View / Pay Invoice</a>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            
                            <!-- Pagination -->
                            <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" t-att-disabled="state.invoicesOffset === 0" t-on-click="prevInvoices">
                                    <i class="fa fa-chevron-left me-1"></i> Previous
                                </button>
                                <span class="text-muted small">
                                    Showing <t t-esc="state.invoicesOffset + 1"/> to <t t-esc="Math.min(state.invoicesOffset + state.invoicesLimit, state.invoicesTotal)"/> of <t t-esc="state.invoicesTotal"/>
                                </span>
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" t-att-disabled="state.invoicesOffset + state.invoicesLimit >= state.invoicesTotal" t-on-click="nextInvoices">
                                    Next <i class="fa fa-chevron-right ms-1"></i>
                                </button>
                            </div>
                        </t>
                    </t>
                    
                    <!-- Documents Tab -->
                    <t t-if="state.activeTab === 'documents'">
                        <t t-if="state.loadingDocuments">
                            <div class="text-center py-4"><i class="fa fa-spinner fa-spin text-primary fa-2x"></i></div>
                        </t>
                        <t t-elif="state.documents.length === 0">
                            <div class="alert alert-secondary text-center">No documents attached.</div>
                        </t>
                        <t t-else="">
                            <div class="list-group list-group-flush">
                                <t t-foreach="state.documents" t-as="doc" t-key="doc.id">
                                    <a t-att-href="doc.url" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded p-2 me-3 text-center" style="width: 45px;">
                                                <i class="fa fa-file-pdf-o text-danger fa-lg" t-if="doc.mimetype === 'application/pdf'"></i>
                                                <i class="fa fa-image text-info fa-lg" t-elif="doc.mimetype.includes('image')"></i>
                                                <i class="fa fa-file-text-o text-secondary fa-lg" t-else=""></i>
                                            </div>
                                            <span class="font-weight-bold text-dark"><t t-esc="doc.name"/></span>
                                        </div>
                                        <span class="btn btn-sm btn-light rounded-circle shadow-sm"><i class="fa fa-download text-primary"></i></span>
                                    </a>
                                </t>
                            </div>
                            
                            <!-- Pagination -->
                            <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" t-att-disabled="state.documentsOffset === 0" t-on-click="prevDocuments">
                                    <i class="fa fa-chevron-left me-1"></i> Previous
                                </button>
                                <span class="text-muted small">
                                    Showing <t t-esc="state.documentsOffset + 1"/> to <t t-esc="Math.min(state.documentsOffset + state.documentsLimit, state.documentsTotal)"/> of <t t-esc="state.documentsTotal"/>
                                </span>
                                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" t-att-disabled="state.documentsOffset + state.documentsLimit >= state.documentsTotal" t-on-click="nextDocuments">
                                    Next <i class="fa fa-chevron-right ms-1"></i>
                                </button>
                            </div>
                        </t>
                    </t>
                    
                    <!-- Map Tab -->
                    <t t-if="state.activeTab === 'map'">
                        <div class="card border-0 rounded overflow-hidden">
                            <t t-if="state.property.latitude and state.property.longitude">
                                <iframe 
                                    width="100%" 
                                    height="450" 
                                    frameborder="0" 
                                    scrolling="no" 
                                    marginheight="0" 
                                    marginwidth="0" 
                                    t-attf-src="https://www.openstreetmap.org/export/embed.html?bbox=#{state.property.longitude - 0.01}%2C#{state.property.latitude - 0.01}%2C#{state.property.longitude + 0.01}%2C#{state.property.latitude + 0.01}&amp;layer=mapnik&amp;marker=#{state.property.latitude}%2C#{state.property.longitude}" 
                                    style="border: 1px solid #ddd; border-radius: 5px;">
                                </iframe>
                                <div class="card-footer bg-light text-center mt-3 border-0">
                                    <a t-attf-href="https://www.openstreetmap.org/?mlat=#{state.property.latitude}&amp;mlon=#{state.property.longitude}#map=16/#{state.property.latitude}/#{state.property.longitude}" target="_blank" class="btn btn-primary rounded-pill font-weight-bold px-4">View Larger Map <i class="fa fa-external-link ms-2"></i></a>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="alert alert-secondary text-center m-4 py-5 border-0">
                                    <i class="fa fa-map-o fa-3x mb-3 d-block text-muted"></i>
                                    Location coordinates have not been configured for this project yet.
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>
</templates>
