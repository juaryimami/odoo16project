<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_checklist_template_tree" model="ir.ui.view">
        <field name="name">construction.checklist.template.tree</field>
        <field name="model">construction.checklist.template</field>
        <field name="arch" type="xml">
            <tree string="Checklist Templates">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_construction_checklist_template_form" model="ir.ui.view">
        <field name="name">construction.checklist.template.form</field>
        <field name="model">construction.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <header>
                    <button name="%(construction_erp.action_construction_checklist_import_wizard)d" 
                            string="Import Items" 
                            type="action" 
                            class="btn-primary" 
                            context="{'default_template_id': active_id}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Masonry Quality Checks"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Checklist Items" name="items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="mandatory"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">construction.checklist.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Master Checklist Template
            </p>
            <p>
                Define standardized quality gates that can be pulled into Job Orders automatically.
            </p>
        </field>
    </record>

    <menuitem id="menu_construction_checklist_template"
              name="Checklist Templates"
              parent="menu_construction_configuration"
              action="action_construction_checklist_template"
              sequence="50"/>
</odoo>
