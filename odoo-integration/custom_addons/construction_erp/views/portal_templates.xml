<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="receipt_upload_portal" name="Installment Receipt Upload">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block p-5" data-snippet="s_text_block" data-name="Text">
                    <div class="container border rounded shadow p-5 bg-white" style="max-width: 600px;">
                        <h2 class="text-center mb-4">Installment Payment Receipt</h2>
                        <div class="alert alert-info">
                            <strong>Invoice:</strong> <t t-esc="invoice.name"/><br/>
                            <strong>Amount Due:</strong> <t t-esc="invoice.amount_residual"/> <t t-esc="invoice.currency_id.name"/>
                        </div>
                        <form action="" method="post" enctype="multipart/form-data" class="mt-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="mb-3">
                                <label for="receipt_file" class="form-label">Upload your Payment Receipt (PDF or Image)</label>
                                <input type="file" class="form-control" name="receipt_file" id="receipt_file" required="1" accept="image/*,application/pdf"/>
                            </div>
                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100">Submit Receipt</button>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <template id="receipt_upload_success" name="Upload Success">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block p-5" data-snippet="s_text_block" data-name="Text">
                    <div class="container text-center border rounded shadow p-5 bg-white" style="max-width: 600px;">
                        <i class="fa fa-check-circle text-success mb-4" style="font-size: 80px;"></i>
                        <h2>Thank You!</h2>
                        <p class="lead">Your payment receipt for <strong><t t-esc="invoice.name"/></strong> has been successfully uploaded.</p>
                        <p class="text-muted">Our accounting team will verify the payment and update your installment plan shortly.</p>
                        <a href="/" class="btn btn-primary mt-4">Return Home</a>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
