<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_policy_publish_wizard_form" model="ir.ui.view">
        <field name="name">hr.policy.publish.wizard.form</field>
        <field name="model">hr.policy.publish.wizard</field>
        <field name="arch" type="xml">
            <form string="Publish New Version">
                <group>
                    <field name="template_id" readonly="1" options="{'no_open': True}"/>
                    <field name="version_num"/>
                    <field name="is_major" widget="boolean_toggle"/>
                </group>
                <div class="alert alert-info mt-3" role="alert" attrs="{'invisible': [('is_major', '=', False)]}">
                    <strong>Major Update:</strong> All targeted employees will be required to re-read and re-sign this new version.
                </div>
                <div class="alert alert-warning mt-3" role="alert" attrs="{'invisible': [('is_major', '=', True)]}">
                    <strong>Minor Update:</strong> Employees who already agreed to the previous version will remain in the "Agreed" state for this new version.
                </div>
                <footer>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
