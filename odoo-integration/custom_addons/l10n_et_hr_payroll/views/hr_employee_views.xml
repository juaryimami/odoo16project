<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_l10n_et_hr_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.l10n_et_hr_payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Change Identification No to FAN -->
            <xpath expr="//field[@name='identification_id']" position="attributes">
                <attribute name="string">FAN</attribute>
            </xpath>

            <!-- Add TIN and Pension Number below Identification No -->
            <xpath expr="//field[@name='identification_id']" position="after">
                <field name="tin_number"/>
                <field name="pension_number"/>
            </xpath>
        </field>
    </record>
</odoo>
