<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip_ytd_inherit" inherit_id="hr_payroll_community.report_payslip">
        <!-- Add YTD header column -->
        <xpath expr="//table[2]/thead/tr/th[last()]" position="after">
            <th class="text-right">YTD Total</th>
        </xpath>
        
        <!-- Add YTD data column -->
        <xpath expr="//table[2]/tbody/tr" position="inside">
            <td class="text-right">
                <span t-esc="o.get_ytd_amount(line.code)"
                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </td>
        </xpath>
    </template>
</odoo>
